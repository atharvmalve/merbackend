# =============================================================================
# MERIT BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env and fill in required secrets. Never commit .env to version control.
# =============================================================================

# Application settings
APP_ENV=development
APP_NAME=Merit API
APP_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase configuration (PostgreSQL & Auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# HarvestAPI integration (Direct LinkedIn monitoring)
HARVESTAPI_API_KEY=your-harvestapi-api-key
HARVESTAPI_BASE_URL=https://api.harvestapi.io

# Groq API configuration (OpenAI-compatible)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Operational parameters
DEFAULT_ICP_THRESHOLD=75
MAX_SCAN_CONCURRENCY=3
HTTP_TIMEOUT_SECONDS=30
MAX_WEBSITE_CONTENT_CHARS=30000
